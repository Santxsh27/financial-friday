# Immutable verified 0.18.0 dependencies plus the final committed source.
# Local development still uses the portable Dockerfile/Compose build.
FROM asia-south1-docker.pkg.dev/project-70f2c2d7-4e72-4e59-b14/financial-friday/api@sha256:b73cedb58d038244c2408da02c99683bdf78eb49dd92eec1a03240eb557c013f
USER root
COPY pyproject.toml README.md /app/
COPY src /app/src
COPY tests /app/tests
RUN python -m pip install --no-cache-dir 'pypdf==6.20.1' \
    && python -m pip install --no-cache-dir --no-deps --no-build-isolation .
USER 10001:10001
ENV PYTHONPATH=/app/src
CMD ["python", "-m", "carapace_api"]
