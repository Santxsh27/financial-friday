# Small, reproducible web layer over the verified API release.
# The immutable normal Cloud Build below contains all verified dependencies.
# Copy the complete UI package, including imported presentation modules/assets.
FROM asia-south1-docker.pkg.dev/project-70f2c2d7-4e72-4e59-b14/financial-friday/api@sha256:edc7ee5ac3543b93af4b3f2e0bfcf0a48d21fd6b96423b09b4a024b2fd5e4ae3
COPY src/carapace_integrations /app/src/carapace_integrations
COPY src/carapace_core /app/src/carapace_core
ENV PYTHONPATH=/app/src
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)"
CMD ["python", "-m", "carapace_integrations.friday_cloud_web"]
