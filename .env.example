# Financial Friday defaults to an explicitly labelled offline sandbox planner.
# Internal CARAPACE_* identifiers remain for compatibility; they are not a
# different product. Local chat/document review requires configured live Gemini.
CARAPACE_AI_PROVIDER=local
CARAPACE_GEMINI_MODEL=gemini-3.5-flash-lite

# For the Gemini Developer API free tier, use CARAPACE_AI_PROVIDER=gemini and
# place your AI Studio key below in a local .env file. Never commit that file.
GOOGLE_API_KEY=

# For Vertex AI, use CARAPACE_AI_PROVIDER=vertex with Application Default
# Credentials or a Cloud Run service identity. Do not store service-account keys.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Keep sqlite for local development. Cloud uses Firestore transactional state
# with persistent signing keys; both modes move artificial funds only.
CARAPACE_FRIDAY_DURABLE_STORE=sqlite
CARAPACE_FIRESTORE_DATABASE=(default)
CARAPACE_FIRESTORE_COLLECTION=financial_friday_v1

# Separate per-tenant Release Passport signing keys. The local development
# build can fall back to the demo key; hosted deployments must configure this
# for the historical Release Passport subsystem. It is not the Friday payment
# receipt key, and Cloud KMS signing is not implemented in this prototype.
CARAPACE_PASSPORT_KEYS_JSON=

# Hosted environments must explicitly provision two DIFFERENT protected Ed25519
# private-key file paths. Local development auto-generates separate keys beside
# its SQLite database; neither private key belongs in Git or a browser.
# CARAPACE_BANK_SIGNING_KEY_PATH=/secure/bank-ed25519.pem
# CARAPACE_WITNESS_SIGNING_KEY_PATH=/secure/witness-ed25519.pem
